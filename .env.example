MYSQL_ROOT_PASSWORD=changeme
MYSQL_USER=root
MYSQL_DATABASE=ecommerce
NACOS_AUTH_ENABLE=false
TZ=Asia/Shanghai

# JWT secret (required, change to a strong random string)
JWT_SECRET=changeme

# Database credentials (optional, defaults shown in application.yaml)
# DB_USERNAME=root
# DB_PASSWORD=changeme

# ========== AI Agent (agent-service) ==========
# DashScope (通义千问) API Key
# 获取：https://bailian.console.aliyun.com/?apiKey=1#/api-key
# 必填，否则 Agent 服务无法调用大模型，会在对话时返回错误提示
DASHSCOPE_API_KEY=
# 模型名：qwen-plus（推荐，性价比高）/ qwen-max（最强）/ qwen-turbo（最快）
QWEN_MODEL=qwen-plus
