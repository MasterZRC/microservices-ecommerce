MYSQL_ROOT_PASSWORD=changeme
MYSQL_USER=root
MYSQL_DATABASE=ecommerce
NACOS_AUTH_ENABLE=false
TZ=Asia/Shanghai

# JWT secret (required, change to a strong random string)
JWT_SECRET=changeme

# Database credentials (optional, defaults shown in application.yaml)
# DB_USERNAME=root
# DB_PASSWORD=changeme

# ========== AI Agent (agent-service) ==========
# LLM provider: qwen or deepseek. Defaults to qwen.
LLM_PROVIDER=qwen

# DashScope (通义千问) API Key. Required when LLM_PROVIDER=qwen.
# 获取：https://bailian.console.aliyun.com/?apiKey=1#/api-key
DASHSCOPE_API_KEY=
# 模型名：qwen-plus（推荐，性价比高）/ qwen-max（最强）/ qwen-turbo（最快）
QWEN_MODEL=qwen-plus

# DeepSeek API. Required when LLM_PROVIDER=deepseek.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Keep disabled for tool-calling loops unless reasoning_content is persisted and replayed.
DEEPSEEK_THINKING=disabled
